# Server only: set these in the Vercel project's Environment Variables.
# Never add VITE_ to a service-role or provider key; VITE_ values ship to every browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_ORIGIN=https://moxscore.com

# Public values used only for optional browser Auth. These are not service-role
# credentials. Keep the UI off until the account migration is applied and the
# server-side MOXSCORE_ENABLE_ACCOUNTS flag is enabled in the same environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_ACCOUNTS=false
VITE_ENABLE_PERSISTENCE=false
VITE_ENABLE_COLLECTIONS=false
VITE_ENABLE_DETERMINISTIC_TUNER=false
# UI chrome for /pricing and account billing controls only. Not an entitlement.
# Checkout still requires MOXSCORE_ENABLE_BILLING (+ C1 in Production).
VITE_ENABLE_BILLING=false

# Preview: enable together only after the legal values are approved and the
# migration is applied. Production: enable only after Preview acceptance passes
# and the owner separately approves the Production release.
VITE_ENABLE_SHARING=false
MOXSCORE_ENABLE_SHARING=false
VITE_LEGAL_CONTROLLER_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_SHARED_DECK_RETENTION_DAYS=90
MOXSCORE_SHARED_DECK_RETENTION_DAYS=90
# Used only by Vercel's scheduled daily expired-share cleanup request.
CRON_SECRET=
# Production only: set this after Vercel Firewall rate-limit rules protect
# POST /api/deck, POST /api/import, POST /api/combos, and GET /api/health.
# Without it those public boundaries fail closed with retryable 503 responses.
MOXSCORE_DURABLE_RATE_LIMIT=

# V2 server-side controls. They are intentionally all off by default. Browser
# flags and URLs never grant a capability. Core operating readiness is required
# in Production before optional accounts, saved decks, or collections activate.
# C1 remains only for the deferred billing/provider/Discord programme.
MOXSCORE_ENABLE_ACCOUNTS=false
MOXSCORE_ENABLE_PERSISTENCE=false
MOXSCORE_ENABLE_BILLING=false
MOXSCORE_ENABLE_PRO_AI=false
MOXSCORE_ENABLE_ADVANCED_POD=false
MOXSCORE_ENABLE_DISCORD_LINK=false
MOXSCORE_ENABLE_DISCORD_POD=false
MOXSCORE_ENABLE_COLLECTIONS=false
MOXSCORE_CORE_OPERATING_READINESS=
MOXSCORE_C1_OPERATING_READINESS=

# Optional billing grace period. When unset, a past_due subscription loses Pro
# capabilities immediately. Setting this to true keeps access until the recorded
# period end while dunning runs. It is a deliberate commercial decision with a
# documented refund/cancellation consequence — not a default.
MOXSCORE_BILLING_GRACE_PAST_DUE=false

# Independent billing operations beneath MOXSCORE_ENABLE_BILLING. Closing new
# Checkout must not close Portal or safe handling of existing subscriptions.
# Reconciliation defaults to report-only unless its mode is explicitly repair
# and the separate repair switch is also enabled.
MOXSCORE_ENABLE_CHECKOUT=false
MOXSCORE_ENABLE_WEBHOOK_PROJECTION=false
MOXSCORE_ENABLE_BILLING_RECONCILIATION=false
MOXSCORE_ENABLE_BILLING_REPAIR=false
MOXSCORE_BILLING_RECONCILIATION_MODE=dry_run
MOXSCORE_BILLING_RECONCILIATION_BATCH_SIZE=25
MOXSCORE_BILLING_RECONCILIATION_LEASE_SECONDS=300
MOXSCORE_BILLING_RECONCILIATION_MAX_PAGES=20
MOXSCORE_BILLING_RECONCILIATION_MAX_RUNTIME_SECONDS=240
MOXSCORE_BILLING_PROVIDER_SCAN_LIMIT=500
MOXSCORE_WEBHOOK_STALE_SECONDS=600
MOXSCORE_RECONCILIATION_STALE_HOURS=26

# Constrained Pro AI explanations. The provider-call child switch can be open
# only after one provider/model/key and owner-approved cost controls are all
# configured. There is no default provider, default model, or fallback provider.
# AI_PROVIDER: anthropic | openai | openrouter
# Preferred Preview path: openrouter + anthropic/claude-haiku-4.5 (swap AI_MODEL anytime).
MOXSCORE_ENABLE_AI_PROVIDER_CALLS=false
AI_PROVIDER=
AI_MODEL=
AI_PROVIDER_API_KEY=
# OpenRouter optional attribution headers (defaults: PUBLIC_ORIGIN + "Moxscore").
AI_OPENROUTER_SITE_URL=
AI_OPENROUTER_APP_NAME=
MOXSCORE_AI_DAILY_BUDGET_MICROS=
MOXSCORE_AI_MONTHLY_BUDGET_MICROS=
MOXSCORE_AI_CONCURRENCY_LIMIT=
MOXSCORE_AI_INPUT_COST_PER_MILLION_MICROS=
MOXSCORE_AI_OUTPUT_COST_PER_MILLION_MICROS=
MOXSCORE_AI_MAX_INPUT_TOKENS=3000
MOXSCORE_AI_MAX_OUTPUT_TOKENS=800
MOXSCORE_AI_CONNECT_TIMEOUT_MS=5000
MOXSCORE_AI_READ_TIMEOUT_MS=15000
MOXSCORE_AI_TOTAL_TIMEOUT_MS=25000
MOXSCORE_AI_MAX_RESPONSE_BYTES=32768
MOXSCORE_AI_PROVIDER_LEASE_SECONDS=60

# Stripe, server-side only. Never VITE_-prefixed: these keys must not reach a
# browser bundle. Use test-mode keys everywhere until C1 is affirmative; live
# keys belong only in Production after explicit approval.
# The two price ids are the sole allowlisted plans — the browser sends the key
# name ('pro_monthly' / 'pro_annual'), never a price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
